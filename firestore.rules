rules_version = '2';

// Anyone with the site link can read and write these collections.
// There are no logins, so keep the link within the group.
service cloud.firestore {
  match /databases/{database}/documents {

    function okCollection(col) {
      return col in ['hangouts', 'sessions', 'wishes', 'albums', 'photos'];
    }

    // Blocks junk/abuse: small docs only, and required fields stay strings.
    function okDoc() {
      let d = request.resource.data;
      return d.keys().size() <= 15
        && d.get('by', '') is string
        && d.get('by', '').size() <= 20;
    }

    // Deleting only moves things to Trash (sets deletedAt). It must be "now",
    // so nobody can backdate it to skip the 30-day Trash period.
    function okDeletedAt() {
      let v = request.resource.data.get('deletedAt', null);
      return v == null
        || (resource != null && v == resource.data.get('deletedAt', null))
        || (v is int && v > request.time.toMillis() - 600000 && v < request.time.toMillis() + 600000);
    }

    // Removed for good only after 30 days in Trash
    function trashExpired() {
      let v = resource.data.get('deletedAt', null);
      return v is int && v < request.time.toMillis() - 30 * 24 * 60 * 60 * 1000;
    }

    match /{col}/{id} {
      allow read: if okCollection(col);
      allow create, update: if okCollection(col) && okDoc() && okDeletedAt();
      allow delete: if okCollection(col) && trashExpired();
    }
  }
}
