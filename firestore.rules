rules_version = '2';

// Anyone with the site link can read and write these four collections.
// There are no logins, so keep the link within the group.
service cloud.firestore {
  match /databases/{database}/documents {

    function okCollection(col) {
      return col in ['hangouts', 'sessions', 'wishes', 'albums'];
    }

    // Blocks junk/abuse: small docs only, and required fields stay strings.
    function okDoc() {
      let d = request.resource.data;
      return d.keys().size() <= 15
        && d.get('by', '') is string
        && d.get('by', '').size() <= 20;
    }

    match /{col}/{id} {
      allow read: if okCollection(col);
      allow create, update: if okCollection(col) && okDoc();
      allow delete: if okCollection(col);
    }
  }
}
